<?xml version="1.0" encoding="utf-8"?>
<ui version="1.0">
	<!-- Add texture="ui/background.png" to this sprite. -->
	<sprite name="menu_background" export="1" align="overlap,background" texture="data/ui/background_menu.png"/>
	<sprite name="settings_background" export="1" align="overlap,background"/>
	<sprite name="login_background" export="1" align="overlap,background"/>
	<sprite name="menu_logo" export="1" align="overlap" width="500" height="200" texture="data/ui/Name_Menu.png"/>

	<!-- Main buttons are positioned directly by MenuManager. -->
	<sprite name="start_button" export="1" align="overlap" texcoord_w="0.5" texture="data/ui/Start.png"/>
	<sprite name="settings_button" export="1" align="overlap" texcoord_w="0.5" texture="data/ui/Options.png"/>
	<sprite name="profile_button" export="1" align="overlap" texcoord_w="0.5" texture="data/ui/Profile.png"/>
	<sprite name="exit_button" export="1" align="overlap" texcoord_w="0.5" texture="data/ui/Exit.png"/>
	<sprite name="login_input_background" export="1" align="overlap"/>
	<sprite name="password_input_background" export="1" align="overlap"/>
	<sprite name="confirm_input_background" export="1" align="overlap"/>
	<vbox name="main_screen" export="1">
		<label name="main_status" export="1"><text size="15" align="center" color="#ff6655"></text></label>
	</vbox>

	<vbox name="pause_screen" export="1" width="520" height="420" space_y="14" padding="64">
		<label width="392"><text size="34" align="center">Пауза</text></label>
		<sprite name="resume_button" export="1" width="392" height="48" texcoord_w="0.5" texture="ui/Continue.png"/>
		<sprite name="pause_settings_button" export="1" width="392" height="48" texcoord_w="0.5" texture="ui/Options.png"/>
		<sprite name="pause_profile_button" export="1" width="392" height="48" texcoord_w="0.5" texture="ui/Profile.png"/>
		<sprite name="menu_button" export="1" width="392" height="48" texcoord_w="0.5" texture="ui/Exit.png"/>
	</vbox>

	<vbox name="login_screen" export="1" width="590" height="690" space_y="6" padding="0">
		<label width="590" height="80"><text size="48" align="center">Регистрация</text></label>
		<label width="590" height="30"><text size="22" color="#e6edf8">Табельный номер</text></label>
		<editline name="login_edit" export="1" width="590" height="70" background="0"/>
		<label width="590" height="30"><text size="22" color="#e6edf8">PIN-код</text></label>
		<editline name="password_edit" export="1" width="590" height="70" background="0" password="1"/>
		<label width="590" height="30"><text size="22" color="#e6edf8">Подтвердите PIN-код</text></label>
		<editline name="confirm_password_edit" export="1" width="590" height="70" background="0" password="1"/>
		<label name="login_status" export="1" width="590" height="34"><text size="18" align="center" color="#ffb4ac"></text></label>
<label width="590" height="28"><text size="17" align="center" color="#d5e2f4">— Демонстрационный режим: DEMO / 2026 —</text></label>
<hbox width="590" height="74"><label width="153" height="74"/><sprite name="login_button" export="1" width="283" height="72"/><label width="153" height="74"/></hbox><label name="login_button_label" export="1" align="overlap" width="0" height="0"><text size="1"></text></label>
		<hbox width="590" height="79"><label width="107" height="79"/><hbox width="376" height="79"><sprite name="login_back_button" export="1" align="overlap" width="376" height="79"/><label name="login_back_button_label" export="1" align="overlap" width="376" height="79"><text size="22" align="center">Назад</text></label></hbox><label width="107" height="79"/></hbox>
	</vbox>

	<vbox name="settings_screen" export="1" width="820" height="690" space_y="22" padding="0">
		<label name="settings_title" export="1" width="820" height="64"><text size="42" align="center">&lt;b&gt;Настройки&lt;/b&gt;</text></label>
		<vbox width="760" height="190" space_y="3" padding_l="54" padding_r="26" padding_t="20" padding_b="8">
			<sprite name="volume_panel_background" export="1" align="overlap,background" width="760" height="190" texture="data/ui/Rectangle_Options.png"/>
			<label name="music_title" export="1" width="680" height="35"><text size="32" align="left">&lt;b&gt;Музыка&lt;/b&gt;</text></label>
			<label name="volume_label" export="1" width="680" height="25"><text size="16" align="left">&lt;b&gt;Мелодия меню: 70&lt;/b&gt;</text></label>
			<vbox width="680" height="70">
				<sprite name="music_volume_background" export="1" align="overlap" pos_y="22" width="680" height="25"/>
				<sprite name="music_volume_fill" export="1" align="overlap" pos_y="22" width="680" height="25"/>
				<hslider name="volume_slider" export="1" align="overlap" pos_x="0" pos_y="0" min="0" max="100" value="70" width="680" height="70" button_width="18"/>
			</vbox>
		</vbox>
		<vbox width="760" height="190" space_y="3" padding_l="54" padding_r="26" padding_t="20" padding_b="8">
			<sprite name="sfx_panel_background" export="1" align="overlap,background" width="760" height="190" texture="data/ui/Rectangle_Options.png"/>
			<label name="effects_title" export="1" width="680" height="35"><text size="32" align="left">&lt;b&gt;Эффекты&lt;/b&gt;</text></label>
			<label name="sfx_volume_label" export="1" width="680" height="25"><text size="16" align="left">&lt;b&gt;Звук окружения: 70&lt;/b&gt;</text></label>
			<vbox width="680" height="70">
				<sprite name="sfx_volume_background" export="1" align="overlap" pos_y="22" width="680" height="25"/>
				<sprite name="sfx_volume_fill" export="1" align="overlap" pos_y="22" width="680" height="25"/>
				<hslider name="sfx_volume_slider" export="1" align="overlap" pos_x="0" pos_y="0" min="0" max="100" value="70" width="680" height="70" button_width="18"/>
			</vbox>
		</vbox>
		<sprite name="settings_back_button" export="1" width="320" height="67" texcoord_w="0.5" texture="ui/Back.png"/>
	</vbox>
	<vbox name="profile_screen" export="1" width="1400" height="800" space_y="12" padding="30">
		<label name="profile_title" export="1" width="1340" height="52"><text size="36" align="center" color="#f4f8ff">Профиль сотрудника</text></label>
		<hbox width="1340" height="245" space_x="12">
			<vbox name="profile_summary_panel" export="1" width="660" height="245" space_y="7" padding_l="36" padding_r="24" padding_t="18" padding_b="14">
				<label width="600" height="30"><text size="22" color="#b9d5f4">Данные сотрудника</text></label>
				<label name="profile_name" export="1" width="600" height="37"><text size="26" color="#f4f8ff">Иванов Иван Иванович</text></label>
				<label name="profile_experience" export="1" width="600" height="28"><text size="18" color="#edf3fb">Стаж: 6 лет 4 месяца</text></label>
				<label name="profile_xp" export="1" width="600" height="28"><text size="18" color="#edf3fb">Опыт: 12 480</text></label>
				<label name="profile_employee_id" export="1" width="600" height="28"><text size="18" color="#edf3fb">ID сотрудника: DEMO</text></label>
				<hbox width="600" height="18"><sprite name="profile_xp_background" export="1" align="overlap,left" width="600" height="18"/><sprite name="profile_xp_fill" export="1" align="overlap,left" width="600" height="18"/></hbox>
			</vbox>
			<vbox name="profile_metrics_panel" export="1" width="668" height="245" space_y="3" padding_l="24" padding_r="24" padding_t="18" padding_b="12">
				<label width="610" height="30"><text size="22" color="#b9d5f4">Показатели</text></label>
				<vbox width="610" height="55" space_y="2"><label width="610" height="26"><text size="19" color="#edf3fb">Лояльность пассажиров</text></label><hbox width="610" height="23" space_x="14"><vbox width="500" height="18"><sprite name="loyalty_background" export="1" align="overlap,left" width="500" height="18"/><sprite name="loyalty_fill" export="1" align="overlap,left" width="500" height="18"/></vbox><label name="loyalty_label" export="1" width="75" height="23"><text size="19" align="left" color="#f4f8ff">86%</text></label></hbox></vbox>
				<vbox width="610" height="55" space_y="2"><label width="610" height="26"><text size="19" color="#edf3fb">Безопасность</text></label><hbox width="610" height="23" space_x="14"><vbox width="500" height="18"><sprite name="safety_background" export="1" align="overlap,left" width="500" height="18"/><sprite name="safety_fill" export="1" align="overlap,left" width="500" height="18"/></vbox><label name="safety_label" export="1" width="75" height="23"><text size="19" align="left" color="#f4f8ff">94%</text></label></hbox></vbox>
				<vbox width="610" height="55" space_y="2"><label width="610" height="26"><text size="19" color="#edf3fb">Соблюдение регламента</text></label><hbox width="610" height="23" space_x="14"><vbox width="500" height="18"><sprite name="compliance_background" export="1" align="overlap,left" width="500" height="18"/><sprite name="compliance_fill" export="1" align="overlap,left" width="500" height="18"/></vbox><label name="compliance_label" export="1" width="75" height="23"><text size="19" align="left" color="#f4f8ff">91%</text></label></hbox></vbox>
			</vbox>
		</hbox>
		<vbox name="achievements_panel" export="1" width="1340" height="155" space_y="8" padding_l="24" padding_r="24" padding_t="13" padding_b="10">
			<label width="1292" height="28"><text size="21" color="#b9d5f4">Полученные достижения</text></label>
			<scrollbox name="achievements_scroll" export="1" width="1292" height="95" border="0" background="0" henabled="1" venabled="0" hhidden="3" vhidden="3">
			<align align="left">
			<hbox name="achievements_row" export="1" width="1292" height="95" space_x="0">
				<hbox name="achievement_ACH_PET_01" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_01.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Мягкие лапы — твёрдые правила</text></label><label width="235"><text size="14" color="#b9c9dc">Безопасное размещение</text></label><label width="235"><text size="14" color="#b9c9dc">без конфликта</text></label></vbox></hbox>
				<hbox name="achievement_ACH_PET_02" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_02.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Ошибка признана</text></label><label width="235"><text size="14" color="#b9c9dc">Ошибка в общении признана</text></label><label width="235"><text size="14" color="#b9c9dc">и исправлена</text></label></vbox></hbox>
				<hbox name="achievement_ACH_PET_03" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_03.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Три шага до порядка</text></label><label width="235"><text size="14" color="#b9c9dc">Все этапы выполнены</text></label><label width="235"><text size="14" color="#b9c9dc">правильно</text></label></vbox></hbox>
				<hbox name="achievement_ACH_PET_04" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_04.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Правила без витрины</text></label><label width="235"><text size="14" color="#b9c9dc">Верное решение</text></label><label width="235"><text size="14" color="#b9c9dc">без переноски в продаже</text></label></vbox></hbox>
				<hbox name="achievement_ACH_PET_05" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_05.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Холодная голова</text></label><label width="235"><text size="14" color="#b9c9dc">Спокойствие в сложном</text></label><label width="235"><text size="14" color="#b9c9dc">диалоге</text></label></vbox></hbox>
				<hbox name="achievement_ACH_PET_06" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_PET_06.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Ледяной протокол</text></label><label width="235"><text size="14" color="#b9c9dc">Безопасно, но слишком</text></label><label width="235"><text size="14" color="#b9c9dc">холодно</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_01" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_01.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Тише без приказов</text></label><label width="235"><text size="14" color="#b9c9dc">Шум снижен</text></label><label width="235"><text size="14" color="#b9c9dc">без обвинений</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_02" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_02.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Дипломат без реквизита</text></label><label width="235"><text size="14" color="#b9c9dc">Диалог без дополнительных</text></label><label width="235"><text size="14" color="#b9c9dc">средств</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_03" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_03.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Тихий переезд</text></label><label width="235"><text size="14" color="#b9c9dc">Корректная пересадка</text></label><label width="235"><text size="14" color="#b9c9dc">пассажира</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_04" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_04.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Мест нет — решение есть</text></label><label width="235"><text size="14" color="#b9c9dc">Честное решение</text></label><label width="235"><text size="14" color="#b9c9dc">при отсутствии мест</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_05" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_05.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">На два фронта</text></label><label width="235"><text size="14" color="#b9c9dc">Конфликт удержан</text></label><label width="235"><text size="14" color="#b9c9dc">с двух сторон</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_06" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_06.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Без крайнего виноватого</text></label><label width="235"><text size="14" color="#b9c9dc">Решение без назначения</text></label><label width="235"><text size="14" color="#b9c9dc">виноватых</text></label></vbox></hbox>
				<hbox name="achievement_ACH_NOISE_07" export="1" width="323" height="95" space_x="12" padding_l="8" padding_t="9"><sprite width="58" height="58" texture="data/ui/Achievements/ACH_NOISE_07.png"/><vbox width="235" space_y="5"><label width="235"><text size="17" color="#f4f8ff">Всё правильно. Всё грубо.</text></label><label width="235"><text size="14" color="#b9c9dc">Безопасно, но слишком</text></label><label width="235"><text size="14" color="#b9c9dc">грубо</text></label></vbox></hbox>
				</hbox>
			</align>
			</scrollbox>
			<label name="achievements_empty" export="1" width="1292"><text size="16" align="center" color="#b9c9dc">Достижения пока не получены</text></label>
		</vbox>
		<vbox name="ranking_panel" export="1" width="1340" height="190" space_y="12" padding_l="24" padding_r="24" padding_t="12" padding_b="10">
			<label width="1292" height="28"><text size="21" color="#b9d5f4">Лучшие сотрудники</text></label>
			<vbox width="1292" height="126" space_y="2">
				<hbox width="1292" height="26" space_x="18"><label width="62" height="26"/><label width="100" height="26"><text size="16" align="center" color="#b9d5f4">Место</text></label><label width="300" height="26"><text size="16" align="center" color="#b9d5f4">Сотрудник</text></label><label width="220" height="26"><text size="16" align="center" color="#b9d5f4">ID сотрудника</text></label><label width="24" height="26"/><label width="100" height="26"><text size="16" align="center" color="#b9d5f4">Опыт</text></label><label width="340" height="26"/><label width="38" height="26"/></hbox>
				<hbox name="rank_row_1" export="1" width="1292" height="26" space_x="18"><label width="62" height="26"/><label name="rank_place_1" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">1</text></label><label name="rank_name_1" export="1" width="300" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label name="rank_login_1" export="1" width="220" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label width="24" height="26"/><label name="rank_xp_1" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">0</text></label><hbox width="340" height="18" space_x="0"><label width="40" height="18"/><vbox width="260" height="11"><sprite name="rank_xp_1_background" export="1" align="overlap,left" width="260" height="11"/><sprite name="rank_xp_1_fill" export="1" align="overlap,left" width="260" height="11"/></vbox><label width="40" height="18"/></hbox><label width="38" height="26"/></hbox>
				<hbox name="rank_row_2" export="1" width="1292" height="26" space_x="18"><label width="62" height="26"/><label name="rank_place_2" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">2</text></label><label name="rank_name_2" export="1" width="300" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label name="rank_login_2" export="1" width="220" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label width="24" height="26"/><label name="rank_xp_2" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">0</text></label><hbox width="340" height="18" space_x="0"><label width="40" height="18"/><vbox width="260" height="11"><sprite name="rank_xp_2_background" export="1" align="overlap,left" width="260" height="11"/><sprite name="rank_xp_2_fill" export="1" align="overlap,left" width="260" height="11"/></vbox><label width="40" height="18"/></hbox><label width="38" height="26"/></hbox>
				<hbox name="rank_row_3" export="1" width="1292" height="26" space_x="18"><label width="62" height="26"/><label name="rank_place_3" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">3</text></label><label name="rank_name_3" export="1" width="300" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label name="rank_login_3" export="1" width="220" height="26"><text size="17" align="center" color="#f4f8ff">—</text></label><label width="24" height="26"/><label name="rank_xp_3" export="1" width="100" height="26"><text size="17" align="center" color="#f4f8ff">0</text></label><hbox width="340" height="18" space_x="0"><label width="40" height="18"/><vbox width="260" height="11"><sprite name="rank_xp_3_background" export="1" align="overlap,left" width="260" height="11"/><sprite name="rank_xp_3_fill" export="1" align="overlap,left" width="260" height="11"/></vbox><label width="40" height="18"/></hbox><label width="38" height="26"/></hbox>
			</vbox>
		</vbox>
		<sprite name="profile_back_button" export="1" width="260" height="55" texcoord_w="0.5" texture="ui/Back.png"/>
